{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "noEmit": true,
    "types": ["vite/client"],
    "composite": true,
    "tsBuildInfoFile": "node_modules/.cache/coseed-web.tsbuildinfo",
    "resolveJsonModule": true
  },
  "include": ["src/web/**/*.ts", "src/web/**/*.tsx", "src/contracts/**/*.ts", "src/web/**/*.json"]
}
