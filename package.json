{
  "name": "coseed",
  "version": "0.1.0",
  "private": true,
  "description": "A local project understanding workbench for developers and coding agents.",
  "type": "module",
  "bin": {
    "coseed": "dist/cli/index.js"
  },
  "files": [
    "dist",
    "migrations"
  ],
  "engines": {
    "node": ">=26.13.0 <27",
    "npm": ">=12.2.2 <13"
  },
  "packageManager": "npm@12.2.2",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SimonLysander/coseed.git"
  },
  "scripts": {
    "dev": "concurrently --kill-others -n server,web \"npm run dev:server\" \"npm run dev:web\"",
    "dev:server": "tsx watch --tsconfig tsconfig.server.json --env-file-if-exists=.env src/cli/index.ts start --no-web",
    "dev:web": "node --env-file-if-exists=.env node_modules/vite/bin/vite.js",
    "build": "npm run build:server && npm run build:web",
    "build:server": "node scripts/build-server.mjs",
    "build:web": "vite build",
    "start": "node dist/cli/index.js start",
    "typecheck": "npm run build:server && tsc -p tsconfig.web.json && tsc -p tsconfig.test.json",
    "test": "npm run build && vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build && playwright test",
    "verify:package": "npm run build && node scripts/verify-package.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm test && npm run api:check && npm run format:check",
    "api:generate": "npm run build:server && node scripts/write-api-contract.mjs && node scripts/write-mcp-contract.mjs",
    "api:check": "node scripts/write-api-contract.mjs --check && node scripts/write-mcp-contract.mjs --check",
    "design:build": "node scripts/build-design-system-preview.mjs",
    "design:preview": "node scripts/build-design-system-preview.mjs --serve",
    "test:design": "playwright test --config playwright.design.config.ts",
    "db:migration": "drizzle-kit generate --custom --dialect=sqlite --schema=./src/server/database/schema/index.ts --out=./migrations",
    "verify:database": "npm run build:server && node scripts/verify-snapshot-save-model.mjs && node scripts/verify-database-design.mjs && node scripts/verify-business-design-database.mjs"
  },
  "dependencies": {
    "@animateicons/react": "0.13.0",
    "@antv/x6": "3.1.8",
    "@antv/x6-react-shape": "3.0.1",
    "@fastify/static": "10.1.10",
    "@modelcontextprotocol/node": "2.1.2",
    "@modelcontextprotocol/server": "2.4.0",
    "@nestjs/common": "12.3.3",
    "@nestjs/config": "12.1.0",
    "@nestjs/core": "12.3.3",
    "@nestjs/platform-fastify": "12.3.3",
    "antd": "6.7.0",
    "better-sqlite3": "13.0.3",
    "canonicalize": "5.1.0",
    "commander": "15.0.0",
    "drizzle-orm": "0.45.4",
    "elkjs": "0.12.1",
    "env-paths": "4.0.0",
    "fastify": "5.12.8",
    "jsonpointer": "5.0.1",
    "lru-cache": "11.5.3",
    "markdown-it": "15.0.3",
    "motion": "14.9.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.4.0",
    "@playwright/test": "1.64.1",
    "@types/better-sqlite3": "9.6.0",
    "@types/markdown-it": "14.2.0",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "concurrently": "10.0.6",
    "drizzle-kit": "0.31.11",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "esbuild@0.25.12": true,
    "esbuild@0.18.20": true
  }
}
