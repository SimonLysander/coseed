# Docker Compose 可直接使用默认值。端口为宿主机端口，日志级别用于服务排错。
COSEED_PORT=4310
COSEED_LOG_LEVEL=info
# 自行构建时可选的下载源
# NODE_IMAGE_REPOSITORY=docker.io/library/node
# NPM_CONFIG_REGISTRY=https://registry.npmjs.org/

# 以下设置供 npm run dev 使用。Compose 的数据由命名卷保存。
COSEED_DATA_DIR=./.coseed/development
# COSEED_HOST=127.0.0.1
# COSEED_CONFIG=/absolute/path/to/config.json
