        { "id": "tools", "kind": "interface", "label": "MCP Tools" },
        { "id": "content", "kind": "service", "label": "CoSeed 项目内容服务" },
        { "id": "repository", "kind": "external_system", "label": "业务代码仓库" },
        { "id": "sqlite", "kind": "store", "label": "SQLite" }
      ],
      "edges": [
        { "source": "web", "target": "content", "label": "经 HTTP API 读取项目" },
